# Local testing. For phones, replace localhost with the laptop's LAN IP.
APP_BASE_URL=http://localhost:3000
DATABASE_URL=file:data/event-v2.db
DATABASE_AUTH_TOKEN=
ADMIN_PASSWORD=replace-with-a-long-private-password
SESSION_SECRET=replace-with-at-least-32-random-characters
# Vercel: use https://your-app.vercel.app and a Supabase Transaction pooler URL.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:ENCODED_PASSWORD@POOLER_HOST:6543/postgres
# Copy the exact host/user from Supabase Connect. Server-only: never use NEXT_PUBLIC_.
# DATABASE_AUTH_TOKEN is only used by the legacy Turso adapter, not by PostgreSQL.
